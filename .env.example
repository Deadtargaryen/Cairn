# Copy to .env for local use. Never commit real credentials.

# Safe defaults. Live trading remains blocked unless separately authorized.
ENGINE_MODE=PAPER
ENGINE_SYMBOL=BTCUSDT
BINANCE_ORDER_MODE=observe
BINANCE_ENABLE_LIVE_ORDERS=false
BINANCE_LIVE_CONFIRMATION=

# Required for authenticated Binance account and order operations.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Optional LLM decision support. Disabled by default.
ENGINE_LLM_ENABLED=false
ENGINE_LLM_API_KEY_ENV=OPENAI_API_KEY
ENGINE_LLM_BASE_URL=
ENGINE_LLM_MODEL=
OPENAI_API_KEY=

# Optional endpoints and runtime settings.
BINANCE_REST_BASE_URL=https://api.binance.com
BINANCE_MARKET_WS_URL=wss://stream.binance.com:9443/stream
BINANCE_WS_API_URL=wss://ws-api.binance.com:443/ws-api/v3
BINANCE_RECV_WINDOW_MS=5000
BINANCE_REQUEST_TIMEOUT_S=10
BINANCE_MAX_MARKET_AGE_MS=5000
BINANCE_LOG_LEVEL=INFO

# Conservative engine limits.
ENGINE_SESSION_MINUTES=720
ENGINE_MAX_POSITION_QUOTE=2
ENGINE_MAX_TOTAL_EXPOSURE_QUOTE=2
ENGINE_MAX_DAILY_LOSS_QUOTE=0.50
ENGINE_MAX_CONSECUTIVE_LOSSES=3
